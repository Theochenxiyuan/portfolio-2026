---
import { site } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-[12px] border-b border-gray-100">
    <div class="max-w-page mx-auto px-6 py-4 flex justify-between items-center">
        <a href="/" class="group inline-flex items-center gap-3" aria-label="Home">
            <img src="/logo.webp" alt="" class="h-10 w-10 rounded-xl object-cover" aria-hidden="true">
            <span class="text-3xl font-semibold tracking-[-0.04em] text-primary transition-colors group-hover:text-dark">熙源</span>
            <span class="text-base font-mono uppercase tracking-[0.2em] text-primary transition-colors group-hover:text-dark">Theo</span>
        </a>
        <nav class="hidden md:flex items-center gap-8">
            {site.header.nav.map((item) => (
                <a 
                    href={item.href} 
                    class={`text-base font-medium transition-colors ${item.href === currentPath ? 'text-dark' : 'text-gray-500 hover:text-dark'}`}
                >
                    {item.label}
                </a>
            ))}
        </nav>
    </div>
</header>
