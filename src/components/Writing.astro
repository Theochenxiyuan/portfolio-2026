---
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const posts = await getCollection('case-study');
const sortedPosts = posts.sort((a, b) => b.data.year - a.data.year);
const featuredPosts = sortedPosts.slice(0, 3);

const colors = [
  { bg: 'bg-indigo-50', text: 'text-indigo-700' },
  { bg: 'bg-pink-50', text: 'text-pink-700' },
  { bg: 'bg-emerald-50', text: 'text-emerald-700' },
  { bg: 'bg-orange-50', text: 'text-orange-700' },
  { bg: 'bg-gray-100', text: 'text-gray-700' },
  { bg: 'bg-amber-50', text: 'text-amber-700' },
  { bg: 'bg-blue-50', text: 'text-blue-700' },
  { bg: 'bg-violet-50', text: 'text-violet-700' },
  { bg: 'bg-green-50', text: 'text-green-700' },
  { bg: 'bg-sky-50', text: 'text-sky-700' },
];

function getColor(title: string) {
  return colors[title.charCodeAt(0) % colors.length];
}
---

<section id="writing" class="max-w-page mx-auto px-6 py-16">
    <div class="max-w-2xl mb-16">
        <h2 class="text-3xl font-semibold tracking-tight text-dark mb-6 dark:text-white">{site.writing.title}</h2>
        <p class="text-lg text-gray-600 leading-relaxed dark:text-gray-300">{site.writing.description}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredPosts.map((post) => {
          const color = getColor(post.data.title);
          const hasUiPreview = (post.data.uiShots?.length ?? 0) > 0;
          return (
            <div class="block">
                <a href={`/case-study/${post.slug}`} class="group block">
                    <div class="aspect-[3/4] bg-gradient-to-b from-transparent to-gray-100 dark:to-gray-800 rounded-xl mb-6 relative overflow-hidden flex items-center justify-center">
                        {post.data.image ? (
                            <img src={post.data.image} alt={post.data.title} class="w-32 h-32 object-contain transition-all duration-300 group-hover:-translate-y-2 group-hover:scale-110 group-hover:drop-shadow-xl" />
                        ) : (
                            <div class={`w-full h-full flex items-center justify-center transition-all duration-300 group-hover:-translate-y-2 ${color.bg} dark:bg-gray-800`}>
                                <span class={`text-4xl md:text-5xl font-bold transition-all duration-300 group-hover:scale-110 group-hover:drop-shadow-xl ${color.text} dark:text-gray-100`}>
                                    {post.data.title[0]}
                                </span>
                            </div>
                        )}
                    </div>
                    <div class="flex items-center gap-3 text-sm font-mono text-gray-500 uppercase tracking-wider mb-3 dark:text-gray-400">
                        <span>{post.data.category}</span>
                        <span class="text-gray-300 dark:text-gray-600">—</span>
                        <span>{post.data.year}</span>
                    </div>
                    <h3 class="text-2xl font-semibold tracking-tight text-dark leading-snug dark:text-white">{post.data.title}</h3>
                </a>
                {(hasUiPreview || post.data.demo) && (
                    <div class="flex flex-wrap items-center gap-2 mt-3">
                        {hasUiPreview && (
                            <a href={`/case-study/${post.slug}/ui`} class="inline-flex items-center gap-1.5 text-sm font-medium border border-dark bg-dark text-white px-4 py-2 rounded-full hover:bg-primary hover:border-primary transition-colors dark:border-white dark:bg-white dark:text-gray-900 dark:hover:border-primary dark:hover:bg-primary dark:hover:text-white">
                                UI图展示
                            </a>
                        )}
                        {post.data.demo && (
                            <a href={post.data.demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-medium border border-dark text-dark px-4 py-2 rounded-full hover:bg-dark hover:text-white transition-colors dark:border-gray-300 dark:text-gray-200 dark:hover:bg-white dark:hover:text-gray-900">
                                体验 Demo
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                            </a>
                        )}
                    </div>
                )}
            </div>
          );
        })}
    </div>

    <div class="mt-16 flex justify-center">
        <a href={site.writing.buttonHref} class="bg-dark text-white px-8 py-3.5 rounded-full text-base font-medium hover:bg-gray-800 transition-colors inline-block dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200">
            查看全部作品（{sortedPosts.length}）
        </a>
    </div>
</section>
