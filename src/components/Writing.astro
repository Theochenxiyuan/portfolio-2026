---
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const posts = await getCollection('case-study');
const sortedPosts = posts.sort((a, b) => b.data.year - a.data.year);
const featuredPosts = sortedPosts
  .filter(p => p.data.featured && !p.data.tags?.some(t => t.label === '进行中'))
  .slice(0, 3);

const colors = [
  { bg: 'bg-indigo-50', text: 'text-indigo-700' },
  { bg: 'bg-pink-50', text: 'text-pink-700' },
  { bg: 'bg-emerald-50', text: 'text-emerald-700' },
  { bg: 'bg-orange-50', text: 'text-orange-700' },
  { bg: 'bg-gray-100', text: 'text-gray-700' },
  { bg: 'bg-amber-50', text: 'text-amber-700' },
  { bg: 'bg-blue-50', text: 'text-blue-700' },
  { bg: 'bg-violet-50', text: 'text-violet-700' },
  { bg: 'bg-green-50', text: 'text-green-700' },
  { bg: 'bg-sky-50', text: 'text-sky-700' },
];

function getColor(title: string) {
  return colors[title.charCodeAt(0) % colors.length];
}

function tagColorClasses(color: string) {
  const map: Record<string, string> = {
    amber: 'bg-amber-100 text-amber-700 ring-amber-600/20 dark:bg-amber-900/30 dark:text-amber-400 dark:ring-amber-400/20',
    blue: 'bg-blue-100 text-blue-700 ring-blue-600/20 dark:bg-blue-900/30 dark:text-blue-400 dark:ring-blue-400/20',
    green: 'bg-green-100 text-green-700 ring-green-600/20 dark:bg-green-900/30 dark:text-green-400 dark:ring-green-400/20',
    red: 'bg-red-100 text-red-700 ring-red-600/20 dark:bg-red-900/30 dark:text-red-400 dark:ring-red-400/20',
    indigo: 'bg-indigo-100 text-indigo-700 ring-indigo-600/20 dark:bg-indigo-900/30 dark:text-indigo-400 dark:ring-indigo-400/20',
    pink: 'bg-pink-100 text-pink-700 ring-pink-600/20 dark:bg-pink-900/30 dark:text-pink-400 dark:ring-pink-400/20',
    purple: 'bg-purple-100 text-purple-700 ring-purple-600/20 dark:bg-purple-900/30 dark:text-purple-400 dark:ring-purple-400/20',
    emerald: 'bg-emerald-100 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-900/30 dark:text-emerald-400 dark:ring-emerald-400/20',
    sky: 'bg-sky-100 text-sky-700 ring-sky-600/20 dark:bg-sky-900/30 dark:text-sky-400 dark:ring-sky-400/20',
    orange: 'bg-orange-100 text-orange-700 ring-orange-600/20 dark:bg-orange-900/30 dark:text-orange-400 dark:ring-orange-400/20',
  };
  return map[color] || map.amber;
}
---

<section id="writing" class="max-w-page mx-auto px-6 py-16">
    <div data-reveal class="max-w-2xl mb-16">
        <h2 class="text-3xl font-semibold tracking-tight text-dark mb-6 dark:text-white">{site.writing.title}</h2>
        <p class="text-lg text-gray-600 leading-relaxed dark:text-gray-300">{site.writing.description}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featuredPosts.map((post, index) => {
          const color = getColor(post.data.title);
          const hasUiPreview = (post.data.uiShots?.length ?? 0) > 0;
          return (
            <div data-reveal="scale" class="motion-card group/card block rounded-2xl" style={`--reveal-delay: ${index * 110}ms`}>
                <a href={`/case-study/${post.slug}`} class="group block">
                    <div class="aspect-[3/4] bg-gradient-to-b from-transparent to-gray-100 dark:to-gray-800 rounded-xl mb-6 relative overflow-hidden flex items-center justify-center transition-all duration-300 group-hover:shadow-2xl group-hover:shadow-gray-900/10 dark:group-hover:shadow-black/30">
                        {post.data.image ? (
                            <img src={post.data.image} alt={post.data.title} class="w-32 h-32 object-contain transition-all duration-300 group-hover:-translate-y-2 group-hover:scale-110 group-hover:drop-shadow-xl" />
                        ) : (
                            <div class={`w-full h-full flex items-center justify-center transition-all duration-300 group-hover:-translate-y-2 ${color.bg} dark:bg-gray-800`}>
                                <span class={`text-4xl md:text-5xl font-bold transition-all duration-300 group-hover:scale-110 group-hover:drop-shadow-xl ${color.text} dark:text-gray-100`}>
                                    {post.data.title[0]}
                                </span>
                            </div>
                        )}
                    </div>
                    <div class="flex items-center gap-3 text-sm font-mono text-gray-500 uppercase tracking-wider mb-3 dark:text-gray-400">
                        <span>{post.data.category}</span>
                        <span class="text-gray-300 dark:text-gray-600">—</span>
                        <span>{post.data.year}</span>
                    </div>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 mb-2">
                        {post.data.tags.map((tag) => (
                          <span class={`inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold ring-1 ${tagColorClasses(tag.color)}`}>
                            {tag.label}
                          </span>
                        ))}
                      </div>
                    )}
                    <h3 class="text-2xl font-semibold tracking-tight text-dark leading-snug transition-colors group-hover:text-primary dark:text-white dark:group-hover:text-primary">{post.data.title}</h3>
                </a>
                {(hasUiPreview || post.data.demo) && (
                    <div class="flex flex-wrap items-center gap-2 mt-3">
                        {hasUiPreview && (
                            <a href={`/case-study/${post.slug}/ui`} class="motion-link inline-flex items-center gap-1.5 text-sm font-medium border border-dark bg-dark text-white px-4 py-2 rounded-full hover:bg-primary hover:border-primary dark:border-white dark:bg-white dark:text-gray-900 dark:hover:border-primary dark:hover:bg-primary dark:hover:text-white">
                                UI展示
                            </a>
                        )}
                        {post.data.demo && (
                            <a href={post.data.demo} target="_blank" rel="noopener noreferrer" class="motion-link inline-flex items-center gap-1.5 text-sm font-medium border border-dark text-dark px-4 py-2 rounded-full hover:bg-dark hover:text-white dark:border-gray-300 dark:text-gray-200 dark:hover:bg-white dark:hover:text-gray-900">
                                体验 Demo
                                <svg class="w-3.5 h-3.5 transition-transform group-hover/card:translate-x-0.5 group-hover/card:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                            </a>
                        )}
                    </div>
                )}
            </div>
          );
        })}
    </div>

    <div data-reveal class="mt-16 flex justify-center">
        <a href={site.writing.buttonHref} class="motion-link bg-dark text-white px-8 py-3.5 rounded-full text-base font-medium hover:bg-gray-800 inline-block dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200">
            查看全部作品（{sortedPosts.length}）
        </a>
    </div>
</section>
