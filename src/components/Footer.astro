---
import { site } from '../data/site';
---

<footer class="border-t border-gray-100 mt-8 py-16 dark:border-gray-800">
    <div class="max-w-page mx-auto px-6 flex flex-col md:flex-row justify-between items-start gap-12">
        <div class="text-base text-gray-500 dark:text-gray-400">
            <p class="mb-2">{site.footer.copyright}</p>
        </div>
        
        <div class="flex gap-16 text-base">
            <div class="flex flex-col gap-4 text-right">
                {site.footer.links.map((link) => (
                    <a href={link.href} class="text-gray-500 hover:text-dark transition-colors dark:text-gray-400 dark:hover:text-white">{link.label}</a>
                ))}
            </div>
        </div>
    </div>
</footer>
