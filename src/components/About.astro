---
import { site } from '../data/site';
---

<section id="about" class="max-w-page mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24">
    <div data-reveal>
        <h2 class="text-2xl font-semibold tracking-tight text-dark mb-6 dark:text-white">{site.about.started.title}</h2>
        <div class="space-y-6 text-lg text-gray-600 leading-relaxed dark:text-gray-300">
            {site.about.started.paragraphs.map((p, index) => (
                <p data-reveal style={`--reveal-delay: ${index * 70}ms`}>{p}</p>
            ))}
        </div>
    </div>
    
    <div data-reveal="scale" class="motion-card bg-gray-100 rounded-xl p-8 md:p-10 dark:bg-gray-800" style="--reveal-delay: 120ms">
        <h2 class="text-2xl font-semibold tracking-tight text-dark mb-6 dark:text-white">{site.about.going.title}</h2>
        <div class="space-y-6 text-lg text-gray-600 leading-relaxed dark:text-gray-300">
            {site.about.going.paragraphs.map((p, index) => (
                <p data-reveal style={`--reveal-delay: ${160 + index * 70}ms`}>
                    {p}
                </p>
            ))}
        </div>
    </div>
</section>
