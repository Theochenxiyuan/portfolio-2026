---
import { site } from '../data/site';
---

<section id="about" class="max-w-page mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24">
    <div>
        <h2 class="text-2xl font-semibold tracking-tight text-dark mb-6">{site.about.started.title}</h2>
        <div class="space-y-6 text-lg text-gray-600 leading-relaxed">
            {site.about.started.paragraphs.map((p) => (
                <p>{p}</p>
            ))}
        </div>
    </div>
    
    <div class="bg-gray-100 rounded-xl p-8 md:p-10">
        <h2 class="text-2xl font-semibold tracking-tight text-dark mb-6">{site.about.going.title}</h2>
        <div class="space-y-6 text-lg text-gray-600 leading-relaxed">
            {site.about.going.paragraphs.map((p) => (
                <p>
                    {p}
                </p>
            ))}
        </div>
    </div>
</section>
