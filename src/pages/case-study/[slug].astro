---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('case-study');
  const sortedPosts = posts.sort((a, b) => b.data.year - a.data.year);
  return sortedPosts.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, index },
  }));
}

const { post, index } = Astro.props;
const { Content } = await post.render();
const pageTitle = post.data.title + ' - Case Study';
const pageDescription = post.data.description;
const pageOgImage = post.data.image || '/logo.webp';
const hasUiPreview = (post.data.uiShots?.length ?? 0) > 0;

---

<Layout title={pageTitle} description={pageDescription} ogImage={pageOgImage}>
    <Header />
    <article>
        <!-- Cover Image -->
        {post.data.image && (
            <div class="w-full bg-gradient-to-b from-gray-50 via-gray-50/50 to-white pt-16 pb-4 dark:from-gray-900 dark:via-gray-900/50 dark:to-gray-950">
                <div class="max-w-page mx-auto px-6">
                    <div class="max-w-3xl mx-auto flex justify-center">
                        <img src={post.data.image} alt={post.data.title} class="h-40 md:h-56 w-auto object-contain" />
                    </div>
                </div>
            </div>
        )}

        <!-- Title Section -->
        <header class="max-w-4xl mx-auto px-6 pt-12 pb-12 text-center">
            <div class="flex items-center justify-center gap-4 text-sm font-mono text-gray-500 uppercase tracking-[0.2em] mb-6 dark:text-gray-400">
                <span>{post.data.category}</span>
                <span class="text-gray-300 dark:text-gray-600">—</span>
                <span>{post.data.year}</span>
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-dark leading-[1.1] dark:text-white">
                {post.data.title}
            </h1>
            {post.data.description && (
                <p class="mt-6 text-lg text-gray-500 leading-relaxed max-w-3xl mx-auto dark:text-gray-400">
                    {post.data.description}
                </p>
            )}
            {(hasUiPreview || post.data.demo || post.data.github) && (
                <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                    {hasUiPreview && (
                        <a href={`/case-study/${post.slug}/ui`} class="inline-flex items-center gap-2 text-base font-medium border border-dark bg-dark text-white px-6 py-3 rounded-full hover:bg-primary hover:border-primary transition-colors dark:border-white dark:bg-white dark:text-gray-900 dark:hover:border-primary dark:hover:bg-primary dark:hover:text-white">
                            UI展示
                        </a>
                    )}
                    {post.data.demo && (
                        <a href={post.data.demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-base font-medium border border-dark text-dark px-6 py-3 rounded-full hover:bg-dark hover:text-white transition-colors dark:border-gray-300 dark:text-gray-200 dark:hover:bg-white dark:hover:text-gray-900">
                            体验 Demo
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                        </a>
                    )}
                    {post.data.github && (
                        <a href={post.data.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-base font-medium border border-dark text-dark px-6 py-3 rounded-full hover:bg-dark hover:text-white transition-colors dark:border-gray-300 dark:text-gray-200 dark:hover:bg-white dark:hover:text-gray-900">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                            GitHub
                        </a>
                    )}
                </div>
            )}
        </header>

        <!-- Divider -->
        <div class="max-w-xs mx-auto px-6 mb-16">
            <div class="h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent dark:via-gray-700"></div>
        </div>

        <!-- Content -->
        <div class="max-w-4xl mx-auto px-6 pb-24">
            <div class="prose prose-lg prose-gray max-w-none
                prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-dark dark:prose-headings:text-white
                prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
                prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
                prose-p:text-gray-600 prose-p:leading-relaxed dark:prose-p:text-gray-300
                prose-strong:text-gray-900 dark:prose-strong:text-gray-100
                prose-a:text-primary prose-a:no-underline hover:prose-a:underline
                prose-code:text-primary prose-code:bg-gray-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm dark:prose-code:bg-gray-800
                prose-pre:bg-gray-900 prose-pre:text-gray-100
                prose-blockquote:border-l-primary prose-blockquote:border-l-4 prose-blockquote:pl-6 prose-blockquote:italic prose-blockquote:text-gray-500 dark:prose-blockquote:text-gray-400
                prose-th:text-gray-900 prose-td:text-gray-700 dark:prose-th:text-gray-200 dark:prose-td:text-gray-300
                prose-ul:my-6 prose-li:text-gray-600 dark:prose-li:text-gray-300
                prose-figure:my-10 prose-figcaption:mt-3 prose-figcaption:text-center prose-figcaption:text-sm prose-figcaption:text-gray-500 prose-figcaption:dark:text-gray-400
                prose-img:mx-auto prose-img:max-h-[50vh] prose-img:w-auto prose-img:object-contain prose-img:rounded-xl prose-img:ring-1 prose-img:ring-gray-900/5 prose-img:cursor-pointer prose-img:transition-all prose-img:duration-300 hover:prose-img:scale-[1.02] hover:prose-img:shadow-lg hover:prose-img:shadow-gray-900/10 dark:prose-img:ring-white/10 dark:hover:prose-img:shadow-gray-900/30">
                <Content />
            </div>
            
            <!-- Back Link -->
            <div class="mt-20 pt-8 border-t border-gray-200 flex items-center justify-between dark:border-gray-800">
                <a href="/projects" class="group text-base font-medium text-dark hover:text-primary transition-colors flex items-center gap-2 dark:text-white dark:hover:text-primary">
                    <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    返回作品列表
                </a>
                <span class="text-sm text-gray-400 font-mono dark:text-gray-500">{post.data.category}</span>
            </div>
        </div>
    </article>
    <Footer />
</Layout>
